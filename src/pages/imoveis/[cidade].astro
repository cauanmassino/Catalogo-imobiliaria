---
import { sanityClient, optimizedImage } from '../../lib/sanity';
import type { Property } from '../../lib/sanity';
import Seo from '../../components/Seo.astro';
import { citySlugToLabel } from '../../lib/cities';
import { ArrowLeft, MapPin } from 'lucide-react';
import '../../styles/global.css';

const cityHeroImages: Record<string, string> = {
  'vicente-pires': '/images/cities/vicente-pires.jpg',
  'aguas-claras': '/images/cities/aguas-claras.jpg',
  'guara': '/images/cities/guara.jpg',
  'asa-sul': '/images/cities/asa-sul.jpg',
  'asa-norte': '/images/cities/asa-norte.jpg',
  'sudoeste': '/images/cities/sudoeste.jpg',
  'noroeste': '/images/cities/noroeste.jpg',
  'taguatinga': '/images/cities/taguatinga.jpg',
  'samambaia': '/images/cities/samambaia.jpg',
  'ceilandia': '/images/cities/ceilandia.jpg',
};

export async function getStaticPaths() {
  const citiesRaw: { city: string }[] = await sanityClient.fetch(`
    *[_type == "property" && defined(city)]{
      city
    }
  `);

  const uniqueCities = [...new Set(citiesRaw.map((item) => item.city?.trim()).filter(Boolean))];

  return uniqueCities.map((cidade) => ({
    params: { cidade },
  }));
}

const { cidade } = Astro.params;
const citySlug = cidade?.trim() || '';

const allProperties: Property[] = await sanityClient.fetch(
  `
  *[_type == "property" && defined(city) && lower(city) == lower($cidade)] | order(_createdAt desc) {
    _id,
    title,
    slug,
    city,
    neighborhood,
    type,
    propertyKind,
    price,
    featured,
    bedrooms,
    bathrooms,
    area,
    images
  }
  `,
  { cidade: citySlug }
);

const heroProperty = allProperties[0] ?? null;

const presetHeroImage = citySlug ? cityHeroImages[citySlug] : null;

const heroImage =
  presetHeroImage ??
  (heroProperty?.images?.[0]
    ? optimizedImage(heroProperty.images[0], 1400, 900)
    : null);

const title = citySlugToLabel(citySlug);
---

<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo
      title={`Imóveis em ${title} | Imobiliária`}
      description={`Catálogo de imóveis em ${title}, com curadoria, fotos grandes e experiência premium.`}
    />
  </head>

  <body class="bg-paper text-ink antialiased">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-paper focus:px-4 focus:py-2 focus:rounded-full focus:shadow-lg"
    >
      Pular para o conteúdo
    </a>

    <main id="conteudo">
      <section class="relative overflow-hidden min-h-[56svh] pt-24 sm:pt-28 pb-14 sm:pb-16">
        {heroImage && (
          <img
            src={heroImage}
            alt={heroProperty?.title || title}
            class="absolute inset-0 h-full w-full object-cover"
            loading="eager"
            decoding="async"
            width="1400"
            height="900"
          />
        )}

        <div class="absolute inset-0 bg-[linear-gradient(to_bottom,rgba(8,8,8,0.2),rgba(8,8,8,0.54),rgba(247,243,236,0.96))]" />

        <div class="relative max-w-7xl mx-auto px-5 sm:px-8">
          <a
            href="/"
            class="inline-flex items-center gap-2 rounded-full border border-white/16 bg-white/10 px-4 py-2 text-sm text-white/80 backdrop-blur-md"
          >
            <ArrowLeft size={16} />
            Voltar
          </a>

          <div class="mt-8 max-w-4xl">
            <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-white/70 mb-4">
              {title}
            </p>

            <h1 class="font-display text-[2.55rem] sm:text-6xl lg:text-[5.8rem] font-bold tracking-[-0.05em] leading-[0.95] text-white max-w-4xl">
              Imóveis selecionados em {title}.
            </h1>

            <p class="mt-6 text-sm sm:text-lg text-white/74 max-w-2xl leading-relaxed">
              Uma vitrine com apresentação limpa, card premium e navegação pensada para funcionar muito bem no smartphone.
            </p>
          </div>
        </div>
      </section>

      <section class="relative z-10 -mt-8 sm:-mt-12 bg-paper rounded-t-[2.5rem] sm:rounded-t-[3rem] shadow-[0_-24px_48px_-24px_rgba(22,21,19,0.12)]">
        <div class="max-w-7xl mx-auto px-5 sm:px-8 py-14 sm:py-20 space-y-10">
          <div class="rounded-[1.75rem] border border-mist bg-paper shadow-[0_14px_36px_rgba(22,21,19,0.06)] px-4 sm:px-6 py-4 sm:py-5">
            <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-slate mb-1">Catálogo</p>
            <h2 class="font-display text-xl sm:text-2xl font-semibold text-ink">Encontre com mais precisão</h2>

            <p class="mt-3 text-sm text-slate">
              <span data-results-text>
                {allProperties.length} resultado{allProperties.length === 1 ? '' : 's'} encontrado{allProperties.length === 1 ? '' : 's'}
              </span>
            </p>

            <div class="mt-5 flex flex-wrap gap-2">
              <button
                type="button"
                data-filter-btn="todos"
                class="inline-flex items-center justify-center rounded-full border border-ink bg-ink px-4 py-2 text-sm font-medium text-white transition-colors"
              >
                Todos
              </button>
              <button
                type="button"
                data-filter-btn="casa"
                class="inline-flex items-center justify-center rounded-full border border-mist bg-white px-4 py-2 text-sm font-medium text-slate transition-colors"
              >
                Casa
              </button>
              <button
                type="button"
                data-filter-btn="apartamento"
                class="inline-flex items-center justify-center rounded-full border border-mist bg-white px-4 py-2 text-sm font-medium text-slate transition-colors"
              >
                Apartamento
              </button>
            </div>
          </div>

          <div class="flex items-center justify-between gap-4">
            <div>
              <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-brass-dark mb-2">Resultados</p>
              <h2 class="font-display text-2xl sm:text-4xl font-semibold tracking-tight text-ink">Catálogo atual</h2>
            </div>

            <span class="hidden sm:inline-flex items-center gap-2 rounded-full border border-mist bg-white px-4 py-2 text-sm text-slate">
              <MapPin size={14} />
              <span data-results-count>{allProperties.length}</span> imóveis
            </span>
          </div>

          {allProperties.length > 0 ? (
            <>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-properties-grid>
                {allProperties.map((property) => {
                  const href = property.slug?.current ? `/imovel/${property.slug.current}` : '#';
                  const cardTitle = property.title || 'Imóvel sem título';
                  const city = property.city || 'Cidade não informada';
                  const neighborhood = property.neighborhood || '';
                  const bedrooms = typeof property.bedrooms === 'number' ? property.bedrooms : null;
                  const bathrooms = typeof property.bathrooms === 'number' ? property.bathrooms : null;
                  const area = typeof property.area === 'number' ? property.area : null;
                  const price =
                    typeof property.price === 'number'
                      ? `R$ ${property.price.toLocaleString('pt-BR')}`
                      : 'Preço sob consulta';

                  const propertyKind = property.propertyKind || 'apartamento';

                  let coverImage = '/placeholder-imovel.jpg';

                  try {
                    if (property.images?.[0]) {
                      coverImage = optimizedImage(property.images[0], 600, 450);
                    }
                  } catch {
                    coverImage = '/placeholder-imovel.jpg';
                  }

                  return (
                    <a
                      href={href}
                      data-property-card
                      data-property-kind={propertyKind}
                      class="bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-shadow border border-mist flex flex-col"
                    >
                      <div class="relative overflow-hidden h-64 bg-mist">
                        <img
                          src={coverImage}
                          alt={cardTitle}
                          class="w-full h-full object-cover"
                          loading="lazy"
                          decoding="async"
                        />

                        <span class="absolute top-4 left-4 bg-paper/90 backdrop-blur-md text-ink text-xs font-mono font-semibold px-3 py-1.5 rounded-full z-10">
                          {property.type === 'venda' ? 'Venda' : 'Aluguel'}
                        </span>

                        <span class="absolute top-4 left-[6.5rem] bg-white/90 backdrop-blur-md text-ink text-xs font-mono font-semibold px-3 py-1.5 rounded-full z-10">
                          {propertyKind === 'casa' ? 'Casa' : 'Apartamento'}
                        </span>

                        {property.featured && (
                          <span class="absolute top-4 right-4 bg-brass text-ink text-xs font-mono font-semibold px-3 py-1.5 rounded-full z-10">
                            Destaque
                          </span>
                        )}
                      </div>

                      <div class="p-6 flex flex-col flex-grow">
                        <p class="text-xs font-mono font-medium text-slate uppercase tracking-wide mb-1">
                          {neighborhood ? `${neighborhood}, ` : ''}{city}
                        </p>

                        <h3 class="text-ink font-display font-semibold text-lg mb-3">
                          {cardTitle}
                        </h3>

                        <div class="flex items-center gap-4 text-sm text-slate mb-4 flex-wrap">
                          {bedrooms !== null && <span>{bedrooms} quartos</span>}
                          {bathrooms !== null && <span>{bathrooms} banheiros</span>}
                          {area !== null && <span>{area}m²</span>}
                        </div>

                        <p class="font-display text-2xl font-bold text-ink mt-auto tabular-nums">
                          {price}
                        </p>
                      </div>
                    </a>
                  );
                })}
              </div>

              <div
                data-empty-filter
                class="hidden rounded-[1.75rem] border border-mist bg-white p-8 sm:p-10"
              >
                <p class="font-display text-2xl font-semibold text-ink mb-3">Nenhum imóvel encontrado</p>
                <p class="text-slate leading-relaxed">
                  Não há imóveis nessa categoria em {title}. Tente trocar o filtro para ver mais opções.
                </p>
              </div>
            </>
          ) : (
            <div class="rounded-[1.75rem] border border-mist bg-white p-8 sm:p-10">
              <p class="font-display text-2xl font-semibold text-ink mb-3">Nenhum imóvel encontrado</p>
              <p class="text-slate leading-relaxed">
                Ainda não há imóveis publicados para esta cidade. Volte para a home e veja outras regiões disponíveis.
              </p>
            </div>
          )}
        </div>
      </section>
    </main>

    <script is:inline>
      function updateResultsText(count) {
        const text = `${count} resultado${count === 1 ? '' : 's'} encontrado${count === 1 ? '' : 's'}`;
        const resultsText = document.querySelector('[data-results-text]');
        const resultsCount = document.querySelector('[data-results-count]');

        if (resultsText) resultsText.textContent = text;
        if (resultsCount) resultsCount.textContent = String(count);
      }

      function applyPropertyFilter(filter) {
        const cards = document.querySelectorAll('[data-property-card]');
        const emptyFilter = document.querySelector('[data-empty-filter]');
        let visibleCount = 0;

        cards.forEach((card) => {
          const kind = card.getAttribute('data-property-kind');
          const shouldShow = filter === 'todos' || kind === filter;

          card.classList.toggle('hidden', !shouldShow);

          if (shouldShow) visibleCount += 1;
        });

        if (emptyFilter) {
          emptyFilter.classList.toggle('hidden', visibleCount > 0);
        }

        updateResultsText(visibleCount);

        document.querySelectorAll('[data-filter-btn]').forEach((button) => {
          const isActive = button.getAttribute('data-filter-btn') === filter;

          button.classList.toggle('bg-ink', isActive);
          button.classList.toggle('text-white', isActive);
          button.classList.toggle('border-ink', isActive);

          button.classList.toggle('bg-white', !isActive);
          button.classList.toggle('text-slate', !isActive);
          button.classList.toggle('border-mist', !isActive);
        });
      }

      function bindPropertyFilters() {
        document.querySelectorAll('[data-filter-btn]').forEach((button) => {
          button.addEventListener('click', () => {
            const filter = button.getAttribute('data-filter-btn') || 'todos';
            applyPropertyFilter(filter);
          });
        });

        applyPropertyFilter('todos');
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bindPropertyFilters);
      } else {
        bindPropertyFilters();
      }
    </script>
  </body>
</html>