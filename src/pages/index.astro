          <div class="reveal grid grid-cols-2 gap-4 sm:flex sm:flex-wrap sm:gap-x-8 sm:gap-y-4 border-t border-white/10 pt-6" data-reveal-delay="300">
            {stats.slice(0, 4).map((stat) => (
              <div>
<p class="font-display text-2xl sm:text-3xl font-bold text-white">
  {stat.prefix}{stat.value}
</p>
                <p class="text-[11px] sm:text-xs text-white/45 mt-0.5">{stat.label}</p>
              </div>
            ))}
          </div>
        </div>

      
      </div>
    </section>

    <section id="catalogo" class="relative z-10 -mt-10 sm:-mt-14 bg-paper rounded-t-[2.5rem] sm:rounded-t-[3rem] pt-16 sm:pt-24 pb-20 sm:pb-28 shadow-[0_-24px_48px_-24px_rgba(22,21,19,0.12)]">
      <div class="max-w-7xl mx-auto px-5 sm:px-8">
        <div class="reveal mb-12">
          <p class="font-mono text-xs tracking-[0.15em] uppercase text-brass-dark mb-2">Vitrine</p>
          <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-ink">Imóveis em destaque</h2>
        </div>

{heroListing ? (
  <div class="space-y-6">
<div class="reveal">
  {(() => {
    const property = heroListing;
    const href = property.slug?.current ? `/imovel/${property.slug.current}` : '#';
    const title = property.title || 'Imóvel sem título';
    const city = property.city || 'Cidade não informada';
    const neighborhood = property.neighborhood || '';
    const bedrooms = typeof property.bedrooms === 'number' ? property.bedrooms : null;
    const bathrooms = typeof property.bathrooms === 'number' ? property.bathrooms : null;
    const area = typeof property.area === 'number' ? property.area : null;
    const description = property.description?.trim() || '';
    const price =
      typeof property.price === 'number'
        ? `R$ ${property.price.toLocaleString('pt-BR')}`
        : 'Preço sob consulta';

    let coverImage = '/placeholder-imovel.jpg';

    try {
      if (property.images?.[0]) {
        coverImage = optimizedImage(property.images[0], 1200, 800);
      }
    } catch {
      coverImage = '/placeholder-imovel.jpg';
    }

    return (
      <a
        href={href}
        class="block rounded-[2rem] overflow-hidden border border-mist bg-white shadow-sm hover:shadow-xl transition-shadow"
      >
        <div class="grid lg:grid-cols-2">
          <div class="relative h-[320px] lg:h-full bg-mist">
            <img
              src={coverImage}
              alt={title}
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />

            <span class="absolute top-4 left-4 bg-paper/90 backdrop-blur-md text-ink text-xs font-mono font-semibold px-3 py-1.5 rounded-full z-10">
              {property.type === 'venda' ? 'Venda' : 'Aluguel'}
            </span>

            {property.featured && (
              <span class="absolute top-4 right-4 bg-brass text-ink text-xs font-mono font-semibold px-3 py-1.5 rounded-full z-10">
                Destaque
              </span>
            )}
          </div>

          <div class="p-8 flex flex-col justify-between gap-6">
            <div>
