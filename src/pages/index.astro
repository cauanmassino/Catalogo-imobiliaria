      </div>

      <div class="relative max-w-7xl mx-auto px-5 sm:px-8">
        <div class="grid gap-10 lg:grid-cols-[0.92fr_1.08fr] lg:gap-20 items-start">
          <div class="reveal">
            <p class="font-mono text-[11px] tracking-[0.22em] uppercase text-brass-dark mb-4">Sobre a marca</p>
