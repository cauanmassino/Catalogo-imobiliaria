              <h3 class="font-display text-xl font-semibold text-ink mb-3">
                {title}
              </h3>

              <div class="flex flex-wrap items-center gap-4 text-sm text-slate mb-4">
                {bedrooms !== null && <span>{bedrooms} quartos</span>}
                {bathrooms !== null && <span>{bathrooms} banheiros</span>}
                {area !== null && <span>{area}m²</span>}
              </div>

              <p class="font-display text-2xl font-bold text-ink mt-auto">
                {price}
              </p>
            </div>
          </a>
        </div>
      );
    })}
  </div>
)}
  </div>
) : (
          <p class="text-slate py-12">Nenhum imóvel em destaque publicado ainda.</p>
        )}
      </div>
    </section>

    <section id="regioes" class="relative overflow-hidden py-20 sm:py-32">
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute -left-24 top-10 h-72 w-72 rounded-full bg-brass/8 blur-3xl" />
        <div class="absolute right-[-8rem] bottom-[-6rem] h-96 w-96 rounded-full bg-ink/5 blur-3xl" />
      </div>

      <div class="relative max-w-7xl mx-auto px-5 sm:px-8">
        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20 items-start">
          <div class="reveal lg:sticky lg:top-28">
            <p class="font-mono text-[11px] tracking-[0.22em] uppercase text-brass-dark mb-4">Onde atuamos</p>
