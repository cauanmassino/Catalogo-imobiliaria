                </p>
              )}
            </div>

            <p class="font-display text-3xl font-bold text-ink">{price}</p>
          </div>
        </div>
      </a>
    );
  })()}
</div>

{restFeatured.length > 0 && (
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 pt-4 pb-2 sm:pb-0">
