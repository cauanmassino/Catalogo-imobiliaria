                    <span class="font-mono text-[11px] uppercase tracking-[0.22em] text-slate w-10 shrink-0">
                      {String(i + 1).padStart(2, '0')}
                    </span>

                    <div class="min-w-0 flex-1">
                      <div class="flex items-baseline justify-between gap-4">
