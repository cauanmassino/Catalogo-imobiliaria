---
import { sanityClient, optimizedImage } from '../lib/sanity';
import type { Property } from '../lib/sanity';
import ContactForm from '../components/ContactForm';

import Seo from '../components/Seo.astro';
import { citySlugToLabel } from '../lib/cities';
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import { MessageCircle, ArrowRight, ArrowUpRight } from 'lucide-react';

const featuredProperties: Property[] = await sanityClient.fetch(`
  *[_type == "property" && featured == true] | order(_createdAt desc) [0...7]{
    _id, title, slug, city, neighborhood, type, price, featured,
    bedrooms, bathrooms, area, description, images
  }
`);

const [heroListing, ...restFeatured] = featuredProperties;
const heroPropertyForNav = featuredProperties[0] ?? null;

const citiesRaw: { city: string }[] = await sanityClient.fetch(`
  *[_type == "property" && defined(city)]{ city }
`);

const cityCounts = citiesRaw.reduce<Record<string, number>>((acc, item) => {
  if (!item.city) return acc;
  acc[item.city] = (acc[item.city] || 0) + 1;
  return acc;
}, {});

const cities = Object.entries(cityCounts)
  .map(([city, count]) => ({ city, count }))
  .sort((a, b) => b.count - a.count);

const stats = [
  { label: 'Clientes satisfeitos', value: 197, prefix: '+' },
  { label: 'Anos de mercado', value: 8, prefix: '' },
  { label: 'Imóveis entregues', value: 98, prefix: '+' },
  { label: 'Regiões atendidas', value: 12, prefix: '' },
];

const differentiators = [
  { title: 'Conhecimento local, de verdade', text: 'Do Plano Piloto às cidades satélites, entendemos o ritmo real de cada região.' },
  { title: 'Atendimento direto', text: 'O cliente fala com pessoas reais do primeiro contato à entrega das chaves.' },
  { title: 'Negociação transparente', text: 'Documentação clara, processo objetivo e condução sem ruído.' },
  { title: 'Orientação de financiamento', text: 'Ajudamos a entender a viabilidade antes de qualquer decisão importante.' },
];
---
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo
      title="Imóveis em Brasília e no DF"
      description="Catálogo de imóveis para venda e aluguel em Brasília e no Distrito Federal, com curadoria, atendimento direto e experiência premium."
    />
    <ViewTransitions />
  </head>

  <body class="bg-paper text-ink antialiased font-sans">
    <a href="#catalogo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-paper focus:px-4 focus:py-2 focus:rounded-full focus:shadow-lg">
      Pular para o conteúdo
    </a>

    <header id="site-header" class="header-on-hero fixed top-0 left-0 right-0 z-40 border-b transition-colors duration-300">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 py-4 sm:py-5 flex items-center justify-between gap-4">
<a href="/" class="flex items-center header-text">
<img
  src="/images/logo.png"
  alt="Logo da sua imobiliária"
  class="h-24 sm:h-26 w-auto object-contain"
  loading="eager"
  decoding="async"
/>
</a>

        <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-white/75 header-text">
          <a href="#catalogo" class="hover:text-white transition-colors">Catálogo</a>
          <a href="#regioes" class="hover:text-white transition-colors">Regiões</a>
          <a href="#sobre" class="hover:text-white transition-colors">Sobre</a>
          <a href="#contato" class="hover:text-white transition-colors">Contato</a>
        </nav>

        <a
          href="https://wa.me/5561999835448"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border border-white/20 hover:bg-white hover:text-ink text-white text-sm font-semibold px-4 sm:px-5 py-2.5 rounded-full transition-colors header-text"
        >
          <MessageCircle size={16} /> <span class="hidden sm:inline">Falar no WhatsApp</span><span class="sm:hidden">WhatsApp</span>
        </a>
      </div>
    </header>

    <section class="relative overflow-hidden min-h-[92svh] flex items-end pt-24 pb-10 sm:pb-16 bg-ink noise-texture">
<img
  src="/images/hero.jpg"
  alt="Vista aérea de Brasília à noite"
  class="absolute inset-0 h-full w-full object-cover opacity-190"
  loading="eager"
  decoding="async"
  width="1600"
  height="900"
/>
<div class="absolute inset-0 bg-[linear-gradient(to_bottom,rgba(8,8,8,0.12),rgba(8,8,8,0.28),rgba(247,246,242,0.82))]" />
<div class="absolute inset-0 blueprint-grid opacity-10" />

      <div class="relative w-full max-w-7xl mx-auto px-5 sm:px-8 grid gap-10 lg:grid-cols-[1.08fr_0.92fr] lg:gap-20 items-end">
        <div class="max-w-3xl">
          <p class="reveal font-mono text-[10px] sm:text-[11px] tracking-[0.28em] uppercase text-white/75 mb-5 sm:mb-6">
            Brasília — Distrito Federal
          </p>

          <h1 class="reveal font-display text-[2.55rem] sm:text-6xl lg:text-[5.8rem] font-bold tracking-[-0.04em] leading-[0.96] mb-6 sm:mb-7 text-white" data-reveal-delay="80">
            Imóveis que parecem
            <br />
            <span class="font-light italic text-white/62">merecer</span> Brasília.
          </h1>

          <p class="reveal text-sm sm:text-lg text-white/72 max-w-xl leading-relaxed mb-8 sm:mb-10" data-reveal-delay="150">
            Curadoria de imóveis em Brasília e no DF com atendimento direto, seleção rigorosa e apresentação à altura do mercado de alto padrão.
          </p>

          <div class="reveal flex flex-col sm:flex-row sm:items-center gap-4 mb-10 sm:mb-12" data-reveal-delay="220">
            <a
              href="#catalogo"
              class="group inline-flex items-center justify-center gap-2 bg-brass hover:bg-brass-dark text-ink font-semibold px-6 sm:pl-7 sm:pr-6 py-3.5 rounded-full transition-colors"
            >
              Ver imóveis disponíveis
              <ArrowRight size={18} class="transition-transform group-hover:translate-x-1" />
            </a>

            <a
              href="https://wa.me/5561999835448"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-1.5 text-white/78 hover:text-white text-sm font-medium transition-colors"
